# Copy to .env.local and fill in.

# Privy: dashboard.privy.io → your app → Settings
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: app client ID, if you created one in the Privy dashboard
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Signs session and nonce cookies. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Solana RPC. The public endpoint rate-limits hard; use Helius, Triton or QuickNode for real use.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# The domain whose DNS holds YieldID records: _yid.<handle>.<this domain>
NEXT_PUBLIC_YID_DOMAIN=

# ---- Agent layer (docs/AGENTS.md) ----
# Where agent keys, the spend ledger, proposals and cards are kept.
# file (default, local dev) or memory. Use a real database before deploying.
YID_AGENT_STORE=file
YID_AGENT_STORE_PATH=.data/agent-store.json
# Server-side RPC for pot balance reads (falls back to NEXT_PUBLIC_SOLANA_RPC).
SOLANA_RPC_URL=

# x402 paywall on /api/x402/rates. Leave blank to keep it off.
X402_FACILITATOR_URL=
# Your Solana address that receives the USDC.
X402_PAY_TO=
# solana or solana-devnet
X402_NETWORK=solana-devnet
# Optional; otherwise read from the facilitator's /supported.
X402_FEE_PAYER=
# Price per call in micro-USDC (10000 = 0.01 USDC).
X402_RATES_PRICE_MICRO=10000

# Card issuer: sandbox until a partner is connected (lib/card/partner.ts).
CARD_ISSUER=sandbox
