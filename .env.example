# Copy to .env.local and fill in.

# Privy: dashboard.privy.io → your app → Settings
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: app client ID, if you created one in the Privy dashboard
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Signs session and nonce cookies. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Solana RPC. The public endpoint rate-limits hard; use Helius, Triton or QuickNode for real use.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
# mainnet or devnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet

# The domain whose DNS holds YieldID records: _yid.<handle>.<this domain>
NEXT_PUBLIC_YID_DOMAIN=
