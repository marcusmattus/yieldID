# Copy to .env.local and fill in.

# Privy: dashboard.privy.io → your app → Settings
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: app client ID, if you created one in the Privy dashboard
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Signs session and nonce cookies. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Solana RPC. The public endpoint rate-limits hard; use Helius, Triton or QuickNode for real use.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# The domain whose DNS holds YieldID records: _yid.<handle>.<this domain>
NEXT_PUBLIC_YID_DOMAIN=

# Ramp Network on-ramp (card or bank → USDC in the user's own wallet).
# Without a key the widget opens Ramp's test environment, which only offers Base Sepolia test USDC.
# Get a production host API key from Ramp: https://docs.rampnetwork.com/api-keys
NEXT_PUBLIC_RAMP_HOST_API_KEY=
# production | demo. Defaults to production when a key is set, demo otherwise.
NEXT_PUBLIC_RAMP_ENV=

# x402 paid agent API (/api/x402/yields). Payments go straight to these addresses.
# Networks: solana, solana-devnet, base, base-sepolia (comma list). Testnets by default.
X402_NETWORKS=solana-devnet,base-sepolia
X402_PAY_TO_SOLANA=
X402_PAY_TO_EVM=
# Price per call in USD, paid in USDC.
X402_PRICE_USD=0.001
# x402.org runs the free testnet facilitator. For mainnet use one that settles on Solana and Base,
# for example https://facilitator.payai.network
X402_FACILITATOR_URL=https://x402.org/facilitator
